{
	"folders": [
		{
			"path": ".."
		}
	],
	"settings": {},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "C++ debug",
				"type": "cppdbg",
				"request": "launch",
				"program": "${workspaceFolder}/main",
				"args": [],
				"stopAtEntry": false,
				"cwd": "${workspaceFolder}",
				"environment": [],
				"externalConsole": false,
				"MIMode": "gdb",
				"setupCommands": [
					{
						"description": "Enable pretty-printing for gdb",
						"text": "-enable-pretty-printing",
						"ignoreFailures": true
					}
				]
			},
			{
				"name": "C++ compilar y debuggear",
				"type": "cppdbg",
				"request": "launch",
				"preLaunchTask": "compilar",
				"program": "${workspaceFolder}/main",
				"args": [],
				"stopAtEntry": false,
				"cwd": "${workspaceFolder}",
				"environment": [],
				"externalConsole": false,
				"MIMode": "gdb",
				"setupCommands": [
					{
						"description": "Enable pretty-printing for gdb",
						"text": "-enable-pretty-printing",
						"ignoreFailures": true
					}
				]
			},
			{
				"name": "Go debug",
				"type": "go",
				"request": "launch",
				"mode": "debug",
				"program": "${fileDirname}/${fileBasename}",
				"args": [],
				"env": {},
				"console": "integratedTerminal"
			}
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "🔄 Hacer git pull",
				"detail": "Actualiza workspace y repos en src (clona faltantes definidos en tools/src-repos.txt)",
				"type": "shell",
				"command": "${workspaceFolder}/tools/init-workspace.sh",
				"problemMatcher": []
			},
			{
				"label": "🔧 RECOMPILAR DOCKER",
				"type": "shell",
				"command": "docker compose up -d --build",
				"problemMatcher": []
			},
			{
				"label": "🐳 EJECUTAR COMANDO",
				"type": "shell",
				"command": "docker exec -ti ros2 bash",
				"problemMatcher": []
			},
			{
				"label": "🚀 LEVANTAR DOCKER",
				"type": "shell",
				"command": "docker compose up -d",
				"problemMatcher": []
			},
			{
				"label": "❌ DETENER DOCKER",
				"type": "shell",
				"command": "docker compose down",
				"problemMatcher": []
			},
			{
				"label": "⚙️ COMPILAR ROS",
				"type": "shell",
				"command": "sh tools/compile-ros.sh",
				"problemMatcher": []
			},
			{
				"label": "🖥️ LANZAR SIMULACION",
				"type": "shell",
				"command": "sh tools/exec.sh ros2 launch navegacion_gps simulacion.launch.py",
				"problemMatcher": []
			}
		],
		"inputs": [
			{
				"id": "serviceName",
				"description": "Nombre del servicio de Docker",
				"default": "users-api",
				"type": "promptString"
			},
			{
				"id": "command",
				"description": "Comando a ejecutar",
				"default": "bash",
				"type": "promptString"
			}
		]
	}
}
