{
  "process_list": [
    {
      "label": "🖥️ LANZAR SIMULACION",
      "command": "ros2 launch navegacion_gps simulacion.launch.py ekf_global:=True datum_setter:=True ukf:=True",
      "cwd": "/ros2_ws"
    },
    {
      "label": "🎥 ROSBAG CORE",
      "command": "ros2 bag record -o /ros2_ws/log/bags/nav_debug_core_$(date -u +%Y%m%d_%H%M%S) /gps/fix /odometry/local /odometry/gps /imu/data /scan /cmd_vel /cmd_vel_safe /cmd_vel_final /collision_monitor_state /nav_command_server/telemetry /nav_command_server/events /controller/status /controller/telemetry /diagnostics /tf /tf_static /rosout",
      "cwd": "/ros2_ws"
    },
    {
      "label": "🎥 ROSBAG FULL NAV2",
      "command": "ros2 bag record -o /ros2_ws/log/bags/nav_debug_full_nav2_$(date -u +%Y%m%d_%H%M%S) /gps/fix /odometry/local /odometry/gps /imu/data /scan /cmd_vel /cmd_vel_safe /cmd_vel_final /collision_monitor_state /nav_command_server/telemetry /nav_command_server/events /controller/status /controller/telemetry /diagnostics /tf /tf_static /rosout /plan /local_costmap/costmap /global_costmap/costmap /local_costmap/published_footprint /behavior_tree_log",
      "cwd": "/ros2_ws"
    },
    {
      "label": "🔁 REPRODUCIR ULTIMA BAG",
      "command": "./rosbag_play.sh",
      "cwd": "/ros2_ws/src/utilities/processs_scripts"
    }
  ]
}
